# Google Apps Script Web App URL for Google Sheets RSVP backend
# Replace with your deployed Apps Script Web App URL:
# Format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
VITE_RSVP_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID_HERE/exec

# Optional: Host Admin Key for Apps Script management (if configured in Script Properties)
VITE_ADMIN_KEY=your_admin_secret_key_here

# Base URL path for GitHub Pages deployment (e.g. ./ for relative or /diwaliInvite/)
VITE_BASE_PATH=./
